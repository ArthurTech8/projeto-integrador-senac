<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes automatizados da API (xUnit). Fica FORA da pasta backend/ de propósito:
    assim o Dockerfile da API não copia nem compila os testes, e a imagem continua igual.
    Como rodar sem instalar .NET: veja o compose.testes.yaml (serviço testes-api)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Api.Testes</RootNamespace>
    <!-- xUnit1051 pede CancellationToken em toda chamada: só ruído para testes curtos -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só para os testes: nenhum destes pacotes vai para a imagem da API.
         O xUnit v3 roda na Microsoft.Testing.Platform (ativada no global.json desta pasta). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\backend\Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
