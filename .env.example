# Copie este arquivo para ".env" e troque pelos seus dados. O ".env" NUNCA vai para o Git.
# Cada valor fica numa única linha.

# Banco MySQL no alwaysdata
ConnectionStrings__Padrao=Server=mysql-suaconta.alwaysdata.net;Database=suaconta_projeto;User=suaconta;Password=SUA_SENHA_AQUI;

# Primeiro administrador do sistema. A API cria este usuário quando sobe e ainda não existe nenhum admin.
# Senha com no mínimo 8 caracteres. Depois do primeiro login, troque a senha em "Minha conta".
AdminInicial__Nome=Administrador
AdminInicial__Email=admin@exemplo.com
AdminInicial__Senha=TROQUE_ESTA_SENHA
